{
  // Keep working data out of the file tree and out of search results. Every
  // path here is already git-ignored, but VS Code still lists ignored
  // directories in the explorer, and a Python venv is tens of thousands of
  // files. The root-level and **/ forms of each pattern are both listed so the
  // match does not depend on how the glob is anchored.
  "files.exclude": {
    ".venv*": true,
    "**/.venv*": true,
    "__pycache__": true,
    "**/__pycache__": true,
    "kobo-tts-bundle": true,
    ".cache": true,
    "kokoro/model": true,
    "kokoro/goldens": true,
    "dev/paradee/model": true,
    "dev/paradee/ortlib": true,
    "dev/paradee/device-wav": true
  },
  "search.exclude": {
    ".venv*": true,
    "**/.venv*": true,
    "__pycache__": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "kobo-tts-bundle": true,
    ".cache": true,
    "kokoro/model": true,
    "kokoro/goldens": true,
    "dev/paradee/model": true,
    "dev/paradee/ortlib": true,
    "dev/paradee/device-wav": true,
    "koreader-src": true
  },
  // A venv is 40k files; watching it wastes file handles and CPU.
  "files.watcherExclude": {
    "**/.venv*/**": true,
    "**/__pycache__/**": true
  }
}
